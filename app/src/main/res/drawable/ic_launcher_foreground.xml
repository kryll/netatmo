<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Dial design: center (54,54), ring radius 34.
        Gap at the bottom (45°→135° screen = 4-8 o'clock).
        Ring goes from bottom-left (30,78) counterclockwise through top to bottom-right (78,78).
        Active arc covers ~65% of 270° ≈ 175° — ends at ~1 o'clock (76,28).
    -->

    <!-- Inner decorative ring — subtle depth -->
    <path
        android:pathData="M54,36 a18,18 0 1,0 0.01,0Z"
        android:fillColor="#00000000"
        android:strokeColor="#99FFFFFF"
        android:strokeWidth="1.5" />

    <!-- Ring track (270° — background of the dial) -->
    <path
        android:pathData="M30,78 A34,34 0 1 0 78,78"
        android:fillColor="#00000000"
        android:strokeColor="#40FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- Active arc (~65% warm, from bottom-left counterclockwise to ~1 o'clock) -->
    <path
        android:pathData="M30,78 A34,34 0 0 0 76,28"
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- Indicator dot at arc end -->
    <path
        android:pathData="M71,28 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0"
        android:fillColor="#FFFFFFFF" />

    <!-- Center dot -->
    <path
        android:pathData="M49,54 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0"
        android:fillColor="#CCFFFFFF" />

</vector>
